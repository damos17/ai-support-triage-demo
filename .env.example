# Free, deterministic default. No API key required.
LLM_MODE=mock

# Optional provider-agnostic OpenAI-compatible mode:
# LLM_MODE=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: public embedding
# DEMO_THEME=damos                    # visual theme from app/theme/<name>.css
# FRAME_ANCESTORS=https://example.com # origins allowed to embed the dashboard in an iframe
# DEMO_MAX_CASES=200                  # reset shared demo state after N cases
